# Copy to .env and chmod 600. Never commit .env.
# Email (SMTP). Works with most mail providers that allow SMTP sending. Check your plan's daily sending limits.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_USER=you@example.com
SMTP_PASSWORD=

# SMS via Twilio (or set providers.sms.type = "webhook" in config.json and use SMS_WEBHOOK_URL)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=

# Webhook providers (optional): the engine POSTs JSON to these URLs and your CRM / n8n / Make / Zapier sends.
EMAIL_WEBHOOK_URL=
SMS_WEBHOOK_URL=
WEBHOOK_SECRET=

# Team chat alerts (errors, replies, halts). See safety/notify.py for formats.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_FORMAT=text
