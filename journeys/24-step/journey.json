{
  "name": "24-step B2B nurture",
  "version": 1,
  "language": "en",
  "description": "24 steps over 90 days in 4 phases (introduce, educate, prove, decide). Email every step, a text on 6 steps for contacts with SMS consent.",
  "min_hours_between_steps": 20,
  "stop_rules": {
    "reply": "pause_and_hand_to_human",
    "stop_word": "suppress_forever",
    "unsubscribe": "suppress_forever",
    "hard_bounce": "suppress_channel",
    "booked": "exit_won",
    "do_not_contact_field": "never_enroll"
  },
  "channel_rules": {
    "email": {
      "requires": [
        "email"
      ]
    },
    "sms": {
      "requires": [
        "phone",
        "sms_consent"
      ],
      "only_if_engaged": false
    }
  },
  "steps": [
    {
      "id": "step-01",
      "phase": "introduce",
      "day": 0,
      "channels": [
        "email",
        "sms"
      ],
      "template": "step-01",
      "goal": "Open a conversation"
    },
    {
      "id": "step-02",
      "phase": "introduce",
      "day": 2,
      "channels": [
        "email"
      ],
      "template": "step-02",
      "goal": "Name the problem"
    },
    {
