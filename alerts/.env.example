# Copy to .env and chmod 600. Never commit .env.
# Team chat incoming webhook (Slack, Google Chat, Mattermost, Zoho Cliq channel webhook, Discord...)
ALERT_WEBHOOK_URL=
# text (Slack / Google Chat / Mattermost / Cliq) | discord | generic
ALERT_WEBHOOK_FORMAT=text
# Where tasks are created when crm.type = "webhook" in config.json
CRM_TASK_WEBHOOK_URL=
# Shared secret: required for `serve`, also signs outgoing webhooks (X-Signature-SHA256)
WEBHOOK_SECRET=
