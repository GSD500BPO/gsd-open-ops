[Unit]
Description=Ramón talent-intake
After=network-online.target

[Service]
User=ramon
WorkingDirectory=/opt/ramon
ExecStart=/opt/ramon/.venv/bin/python /opt/ramon/intake_server.py
Restart=on-failure
RestartSec=5
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/opt/ramon
PrivateTmp=true

[Install]
WantedBy=multi-user.target
