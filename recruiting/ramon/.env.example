# Ramón talent pipeline: copy to .env (chmod 600) and fill in. NEVER commit .env.
# Everything is DRY until TALENT_LIVE=1: outbound actions are written to events.jsonl instead of being sent.

# ---------- Safety ----------
TALENT_LIVE=0
# While testing live, only these numbers / emails receive messages (comma-separated, digits with country code)
TALENT_ALLOW=15550000000
TALENT_EMAIL_ALLOW=you@example.com
TALENT_WA_DAILY_CAP=4
# OUTBOUND_GUARD_DIR=./guard            # touch guard/PAUSE_ALL to stop every automated send
# OUTBOUND_GUARD_DAILY_CAP=3

# ---------- Branding / copy ----------
TALENT_COMPANY=Your Company
TALENT_BOT_NAME=Ramón
TALENT_ROLE_TITLE=SDR / BDR (English)
TALENT_CAMPAIGN_BLURB=inbound and outbound calls with U.S. homeowners
TALENT_PAY_LINE=
TALENT_WA_DISPLAY=+1 555 000 0000
TALENT_WA_LINK=https://wa.me/15550000000
TALENT_SITE_URL=https://example.com/talent
TALENT_APPLY_URL=https://example.com/talent/apply
TALENT_HIRING_OPEN=1

# ---------- Thresholds ----------
TALENT_PASS_COMPOSITE=65
TALENT_PASS_ENGLISH=70
TALENT_PASS_SPEAKING=60
# Optional public card rate by score, "min_score:rate" pairs. Empty = no rate anywhere.
TALENT_RATE_LADDER=

# ---------- Phone normalization ----------
# If candidates type local 10-digit mobiles, add your country code (e.g. 57 for Colombia, mobiles start with 3)
TALENT_DEFAULT_COUNTRY_CODE=
TALENT_LOCAL_MOBILE_PREFIX=3

# ---------- WhatsApp Cloud API (Meta) ----------
WA_PHONE_NUMBER_ID=
WA_ACCESS_TOKEN=
WA_APP_SECRET=
WA_VERIFY_TOKEN=generate-a-long-random-string
TALENT_WA_TEMPLATE_LANG=en
TALENT_WA_TEMPLATE_STEPS=recruiting_steps_en
TALENT_WA_TEMPLATE_WELCOME=recruiting_welcome_en
TALENT_WA_TEMPLATE_REMINDER=recruiting_reminder_en
# Meta lead forms (optional; or list several in jobs.json)
TALENT_FORM_ID=
META_LEADS_TOKEN=

# ---------- Zoho (Recruit + Mail + Cliq) ----------
ZOHO_CLIENT_ID=
ZOHO_CLIENT_SECRET=
ZOHO_RECRUIT_REFRESH_TOKEN=
TALENT_JOB_ID=
TALENT_INTERVIEWER_ID=
ZOHO_MAIL_CLIENT_ID=
ZOHO_MAIL_CLIENT_SECRET=
ZOHO_MAIL_REFRESH_TOKEN=
ZOHO_MAIL_ACCOUNT_ID=
TALENT_MAIL_FROM=hiring@example.com
TALENT_MAIL_CC=
TALENT_HIRING_INBOX=hiring@example.com
CLIQ_REFRESH_TOKEN=
TALENT_CLIQ_CHANNEL=recruiting

# ---------- Supabase (private video storage + public talent page) ----------
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_KEY=
TALENT_VIDEO_BUCKET=agent-videos
TALENT_REELS_BUCKET=talent-video-reels
TALENT_PHOTOS_BUCKET=agent-photos
# REQUIRED before anything is published: long random secret (openssl rand -hex 32). Never reuse across deployments.
TALENT_REEL_SALT=
TALENT_MARKETPLACE_CATEGORY=

# ---------- Speaking score / roleplay ----------
TALENT_SPEECH=1
TALENT_SPEECH_ON_ERROR=review
TALENT_SPEECH_TIMEOUT=1500
TALENT_WHISPER=small
TALENT_SPEECH_THREADS=4
LT_SERVER=http://127.0.0.1:8790
TALENT_ROLEPLAY=0
TALENT_ROLEPLAY_SCENARIO=water_treatment

# ---------- Intake server (apply page + web roleplay) ----------
TALENT_INTAKE_HOST=127.0.0.1
TALENT_INTAKE_PORT=8788
TALENT_CORS_ORIGINS=https://example.com,https://www.example.com
TALENT_CORS_ORIGIN_REGEX=

# ---------- Optional: share with a client (both OFF by default) ----------
TALENT_CLIENT_SHARE=0
CLIENT_CLIQ_CLIENT_ID=
CLIENT_CLIQ_CLIENT_SECRET=
CLIENT_CLIQ_REFRESH_TOKEN=
CLIENT_CLIQ_CHANNEL=
TALENT_CLIENT_SHARE_TEMPLATE=
TALENT_CLIENT_ATS_MIRROR=0
CLIENT_RECRUIT_CLIENT_ID=
CLIENT_RECRUIT_CLIENT_SECRET=
CLIENT_RECRUIT_REFRESH_TOKEN=
CLIENT_RECRUIT_JOB_ID=
